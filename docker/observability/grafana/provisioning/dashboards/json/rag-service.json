{
  "uid": "rag-service",
  "title": "RAG Service",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP request rate by route and status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{uri}} {{status}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Chat and retrieval latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(rag_operation_duration_seconds_bucket{operation=~\"chat|chat_stream|semantic_search|lexical_search|rerank\"}[5m])))", "legendFormat": "{{operation}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Operation outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (operation, outcome) (rate(rag_operations_total[5m]))", "legendFormat": "{{operation}} {{outcome}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Streaming first-token latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(rag_chat_time_to_first_token_seconds_sum[5m]) / clamp_min(rate(rag_chat_time_to_first_token_seconds_count[5m]), 0.001)", "legendFormat": "mean seconds" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Embedding cache and retrieval candidates",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(rag_embedding_cache_hits_total[5m]))", "legendFormat": "cache hits/s" },
        { "expr": "sum(rate(rag_retrieval_candidates_total[5m]))", "legendFormat": "candidates/s" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Ingestion documents, chunks, assets and failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(rag_ingestion_documents_total[5m]))", "legendFormat": "documents/s" },
        { "expr": "sum(rate(rag_ingestion_chunks_total[5m]))", "legendFormat": "chunks/s" },
        { "expr": "sum(rate(rag_ingestion_assets_total[5m]))", "legendFormat": "assets/s" },
        { "expr": "sum(rate(rag_ingestion_failures_total[5m]))", "legendFormat": "failures/s" }
      ]
    }
  ]
}
